{
  "name": "pentacles-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pentacles — a sky-gated astrology game and Constellation DEX web client",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:chart": "node src/alchm-chart/__tests__/math.test.js",
    "build:chart": "vite build --config vite.alchm.config.js",
    "serve": "bun run serve.ts",
    "gen": "spacetime generate --lang typescript --module-path server --out-dir src/module_bindings -y && node scripts/patch-bindings.mjs"
  },
  "devDependencies": {
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@dynamic-labs/ethereum": "^4.90.0",
    "@dynamic-labs/sdk-react-core": "^4.90.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "spacetimedb": "^2.6.0",
    "three": "^0.185.0",
    "viem": "^2.53.1"
  }
}
