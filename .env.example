# Pentacles web client — environment (copy to .env.local and fill in for LIVE mode).
# All are OPTIONAL: with none set, the client runs in fully-labeled simulation.
# Canonical public testnet addresses are recorded in docs/TESTNET_DEPLOYMENT.md.

# ---- Phase 1: live SpacetimeDB connection -------------------------------------
# Host of the deployed module (http(s) or ws(s) accepted). Leave blank for offline.
#   e.g. https://maincloud.spacetimedb.com  (or your self-hosted host)
VITE_SPACETIMEDB_URI=https://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB=cookingwithcastrollc
# Poll interval (ms) for the HTTP "subscriptions".
VITE_SPACETIMEDB_POLL_MS=6000

# ---- Auth: Google sign-in via the shared alchm.kitchen login ------------------
# The Pentacles OIDC issuer (mints a SpacetimeDB-compatible JWT from a kitchen
# session) and the kitchen origin the sign-in redirect targets. Defaults are the
# live deployment; blank/unreachable → the app stays on anonymous identities.
VITE_OIDC_ISSUER=https://api.agents.alchm.kitchen
VITE_KITCHEN_ORIGIN=https://alchm.kitchen

# ---- Phase 2: Dynamic wallet (React island) -----------------------------------
# Environment ID from the Dynamic dashboard. Blank → fall back to injected
# (window.ethereum) wallet + simulated balances.
VITE_DYNAMIC_ENV_ID=

# ---- Phase 2/3: Base Sepolia on-chain (Constellation DEX) ----------------------
# Public RPC override (defaults to https://sepolia.base.org).
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
# Deployed contracts (Base Sepolia, chain 84532) — defaults are the live testnet
# deployment; override only if you redeploy.
VITE_CONSTELLATION_AMM=0x6B4EE164320e9E5583C0F6BEe14D5BABb5ba5095
VITE_CONSTELLATION_DEED=0x34eAC0fe797df2889d9dc59Cb98dCe24154BB9B6
VITE_ESMS_TOKEN=0x124ECa1bb1E106D3614A22A256f9A412FfeEAd8F
# LP-position discovery scans PoolSeeded logs. Public RPCs cap eth_getLogs at
# 2000 blocks, so the client scans a bounded recent window in chunks. Pin the
# AMM deploy block (42977141 for the live testnet deployment) for full history;
# blank falls back to the bounded lookback window (positions older than the
# window silently disappear).
VITE_AMM_FROM_BLOCK=42977141
VITE_AMM_LOOKBACK_BLOCKS=40000

# ---- Phase 3: sponsored gas (ERC-4337, Alchm Chart swaps) ----------------------
# Bundler RPC for Base Sepolia (e.g. a Coinbase Developer Platform or Pimlico
# endpoint). Blank → sponsored swaps are off and the chart Swap button says so.
VITE_BUNDLER_URL=
# Paymaster service URL (optional — leave blank to let the bundler sponsor).
VITE_PAYMASTER_URL=

# ---- Omnichain ESMS burn settlement (server-only; never prefix secrets VITE_) --
# `bun run serve` submits holder-signed redeemFor authorizations through this
# BURNER_ROLE wallet, then records the confirmed Redeemed event in SpacetimeDB.
# Public address derived from REDEEMER_PRIVATE_KEY. Its on-chain role must be
# verified before enabling settlement.
ESMS_SETTLEMENT_WALLET=
REDEEMER_PRIVATE_KEY=
# MINTER_ROLE signer used only by the bridge feeder for Solana → EVM mints.
# A funded address is insufficient: verify MINTER_ROLE on VITE_ESMS_TOKEN.
MINTER_PRIVATE_KEY=
BASE_SEPOLIA_RPC=https://sepolia.base.org
BRIDGE_EVM_CONFIRMATIONS=12
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DB=cookingwithcastrollc
SPACETIME_TOKEN=

# Always-on feeder supervisor. Keep signer/API values server-side.
ANTHROPIC_API_KEY=
ATTESTOR_PRIVATE_KEY=
AMM_CONTRACT_ADDRESS=0x6B4EE164320e9E5583C0F6BEe14D5BABb5ba5095
ESMS_TOKEN=0x124ECa1bb1E106D3614A22A256f9A412FfeEAd8F
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
PLANETARY_AGENTS_BACKEND_URL=https://api.agents.alchm.kitchen
BRAIN_FALLBACK_URL=https://alchm-agents-eth.vercel.app
WTEN_BACKEND_URL=https://whattoeatnext-production.up.railway.app
FEED_INTERVAL_MIN=15
HEALTH_INTERVAL_MS=300000

# ---- Solana (client) ----------------------------------------------------------
# Cluster is DECLARED, never inferred from an RPC URL. Accepts `devnet` or
# `mainnet-beta`. Every worker proves this against the live genesis hash before
# it signs anything, so a stale RPC override fails loudly instead of settling on
# the wrong network.
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Pentacles' own program: StarVault USDC custody and the starUSDC transfer hook.
# It no longer issues ESMS.
VITE_SOLANA_PROGRAM_ID=7MPHZUmxFcLQiqmhnfvgVtTsMRu7jHdmGzjZbKbECE5R
# USDC for the active cluster. Blank uses the built-in default per cluster.
VITE_SOLANA_USDC_MINT=
# starUSDC LST mint (liquid star receipts). Not deployed yet; blank disables
# receipt transfers in the UI rather than faking them.
VITE_SOLANA_STARUSDC_MINT=

# ESMS mints are NOT configured. AlchmAgentsSolana is the sole issuer, and its
# four Token-2022 mints are PDAs at [b"esms_mint", &[element_id]] of the ASOL
# program id — identical on every cluster and derived at runtime, so there is no
# env var to get wrong. The retired 18-decimal Pentacles mints
# (EvkLzWbv…, 28Ctdw…, HG9JbH…, 7eC5Jj…) are abandoned in place on devnet.

# Relayer that submits ASOL `redeem_for_esms` on the player's behalf. ASOL's
# mints are NonTransferable with PermissionedBurn, so a burn must be co-signed
# by ASOL's mint authority — a player cannot burn directly. Blank disables
# Solana ESMS spending with an explicit message.
VITE_SOLANA_RELAYER_URL=
# 32-byte hex from ASOL's ProgramConfig.cluster_domain. The mainnet value is
# known and built in; devnet's is not published, so set it here for devnet. A
# wrong value produces a signature that silently fails on-chain verification.
VITE_ASOL_CLUSTER_DOMAIN=

# ---- Solana (server-side feeders) ---------------------------------------------
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Comma-separated fallbacks. The ingestion supervisor rotates through these on
# WebSocket failure before degrading to polling backfill.
SOLANA_RPC_FALLBACKS=
SOLANA_PROGRAM_ID=7MPHZUmxFcLQiqmhnfvgVtTsMRu7jHdmGzjZbKbECE5R

# Optional Yellowstone gRPC Geyser (tier 1 ingestion). Without it the supervisor
# starts at tier 2 (WebSocket) and keeps tier 3 (polling) running underneath.
SOLANA_GEYSER_ENDPOINT=
SOLANA_GEYSER_X_TOKEN=

# ---- Solana signing -----------------------------------------------------------
# MAINNET REQUIRES CLOUD KMS. Set exactly one key id plus the public key it
# corresponds to (KMS signs but does not reveal a Solana address). Resolving a
# mainnet cluster with an in-memory keypair is refused outright.
AWS_KMS_KEY_ID=
GCP_KMS_KEY_NAME=
SOLANA_SERVICE_PUBLIC_KEY=
# Devnet-only convenience: JSON array of the signer keypair's 64 bytes. Ignored
# when a KMS key is set, and rejected on mainnet or under NODE_ENV=production.
SOLANA_MINTER_SECRET_KEY=
