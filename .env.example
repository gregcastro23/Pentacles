# Pentacles web client — environment (copy to .env.local and fill in for LIVE mode).
# All are OPTIONAL: with none set, the client runs in fully-labeled simulation.

# ---- Phase 1: live SpacetimeDB connection -------------------------------------
# Host of the deployed module (http(s) or ws(s) accepted). Leave blank for offline.
#   e.g. https://maincloud.spacetimedb.com  (or your self-hosted host)
VITE_SPACETIMEDB_URI=https://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB=cookingwithcastrollc
# Poll interval (ms) for the HTTP "subscriptions".
VITE_SPACETIMEDB_POLL_MS=6000

# ---- Auth: Google sign-in via the shared alchm.kitchen login ------------------
# The Pentacles OIDC issuer (mints a SpacetimeDB-compatible JWT from a kitchen
# session) and the kitchen origin the sign-in redirect targets. Defaults are the
# live deployment; blank/unreachable → the app stays on anonymous identities.
VITE_OIDC_ISSUER=https://api.agents.alchm.kitchen
VITE_KITCHEN_ORIGIN=https://alchm.kitchen

# ---- Phase 2: Dynamic wallet (React island) -----------------------------------
# Environment ID from the Dynamic dashboard for Solana wallet connectivity.
VITE_DYNAMIC_ENV_ID=

# ---- SpacetimeDB server credentials (server-only; never prefix secrets VITE_) --
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DB=cookingwithcastrollc
SPACETIME_TOKEN=

# Always-on feeder supervisor. Keep signer/API values server-side.
ANTHROPIC_API_KEY=
PLANETARY_AGENTS_BACKEND_URL=https://api.agents.alchm.kitchen
BRAIN_FALLBACK_URL=https://alchm-agents-eth.vercel.app
WTEN_BACKEND_URL=https://whattoeatnext-production.up.railway.app
FEED_INTERVAL_MIN=15
HEALTH_INTERVAL_MS=300000

# ---- Solana (client) ----------------------------------------------------------
# Cluster is DECLARED, never inferred from an RPC URL. Accepts `devnet` or
# `mainnet-beta`.
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Pentacles' own program: StarVault USDC custody and the starUSDC transfer hook.
VITE_SOLANA_PROGRAM_ID=7MPHZUmxFcLQiqmhnfvgVtTsMRu7jHdmGzjZbKbECE5R
# USDC for the active cluster. Blank uses the built-in default per cluster.
VITE_SOLANA_USDC_MINT=
VITE_SOLANA_STARUSDC_MINT=

# Relayer that submits ASOL `redeem_for_esms` on the player's behalf.
VITE_SOLANA_RELAYER_URL=
# 32-byte hex from ASOL's ProgramConfig.cluster_domain.
VITE_ASOL_CLUSTER_DOMAIN=

# ---- Solana (server-side feeders) ---------------------------------------------
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_FALLBACKS=
SOLANA_PROGRAM_ID=7MPHZUmxFcLQiqmhnfvgVtTsMRu7jHdmGzjZbKbECE5R

# Optional Yellowstone gRPC Geyser (tier 1 ingestion).
SOLANA_GEYSER_ENDPOINT=
SOLANA_GEYSER_X_TOKEN=

# ---- Solana signing -----------------------------------------------------------
AWS_KMS_KEY_ID=
GCP_KMS_KEY_NAME=
SOLANA_SERVICE_PUBLIC_KEY=
SOLANA_MINTER_SECRET_KEY=
