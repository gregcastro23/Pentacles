# ============================================================================
# Pentacles feeders — agent-brain wiring env
# ============================================================================
# The feeders subscribe to SpacetimeDB over WebSocket, ask an "agent brain" for
# a move, and write the answer back via OWNER-GATED reducers. So the identity
# behind SPACETIME_TOKEN (or your logged-in `spacetime` CLI) MUST be the module
# owner (game_config.owner) or every answer_* write is rejected.
#
# Copy to `.env` and fill in. Run a feeder with:  bun run duel | jing | oracle
# ----------------------------------------------------------------------------

# Or run every feeder under one supervising process (for hosting):
#   bun run all
# ----------------------------------------------------------------------------

# ── SpacetimeDB connection (all feeders) ────────────────────────────────────
SPACETIMEDB_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DB=pentacles2xtest          # the 2.x test DB (prod = cookingwithcastrollc)
SPACETIME_TOKEN=                        # owner bearer token; if blank, the `spacetime` CLI
                                        # (logged in as the owner) is used for writes
# SPACETIMEDB_CLI=spacetime             # optional: explicit path to the spacetime binary
# RESWEEP_MS=300000                     # unanswered-row /sql re-sweep period (all feeders)
# ORACLE_RATE_PER_HOUR=60               # oracle only: hourly cap on Claude calls (excess queues FIFO)

# ── Word Duel + Jing brain (bun run duel | jing) ────────────────────────────
# Both services route through brain.ts: PRIMARY → FALLBACK → local move.
#   word-duel: POST /api/agents/word-duel {planet,rack,candidates,context}
#              → {success, planet, move:{word,rationale,score,source,latencyMs}, timestamp}
#   jing:      POST /api/agents/jing {planet,opening}
#              → {success, planet, move, voice, element, source, timestamp}
#
# PRIMARY (default https://api.agents.alchm.kitchen): the planetary-agents
# FastAPI backend on Railway. The move endpoints are ported there but may 404
# until its next deploy — any primary failure (network, non-2xx, bad body)
# automatically retries the FALLBACK, so leaving the defaults is safe.
# Local dev: http://localhost:8000 (FastAPI) or http://localhost:3000 (Next.js).
# PLANETARY_AGENTS_BACKEND_URL=https://api.agents.alchm.kitchen

# FALLBACK (default https://alchm-agents-eth.vercel.app): the AlchmAgents
# Next.js app on Vercel — the currently-live brain. Only when BOTH hosts fail
# does each service use its local move (duel: greedy candidate; jing: counter
# graph — still a winning move, no persona voice).
# BRAIN_FALLBACK_URL=https://alchm-agents-eth.vercel.app

# ── Oracle brain (bun run oracle) — talks to Anthropic directly ─────────────
ANTHROPIC_API_KEY=                      # REQUIRED for the oracle feeder (it exits without it)
# The oracle also enriches each USER message with the live sky fetched from
# ${PLANETARY_AGENTS_BACKEND_URL}/planetary/current (4s timeout, cached 10 min;
# skipped silently on failure). No extra knob — same primary URL as above.

# ── Supervisor health loop (bun run all) ────────────────────────────────────
# Every HEALTH_INTERVAL_MS (first pass ~15s after boot) the supervisor probes
# the planetary-agents + WTEN backends' /health and reports each — plus its own
# "feeders" heartbeat — via the owner-gated report_service_health reducer.
# Report failures are logged and ignored (the reducer only exists after the
# next module publish), so these are safe to leave default everywhere.
# HEALTH_INTERVAL_MS=300000             # probe/report period (default 5 min)
# WTEN_BACKEND_URL=https://whattoeatnext-production.up.railway.app

# ----------------------------------------------------------------------------
# AlchmAgents backend (separate repo) keys — set THERE, not here:
#   GROQ_API_KEY or AI_GATEWAY_API_KEY  → enables the LLM word/jing move
#   (without them the brain still returns a deterministic persona move)
# ----------------------------------------------------------------------------
